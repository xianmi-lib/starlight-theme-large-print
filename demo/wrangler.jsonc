{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "starlight-theme-large-print",
	"compatibility_date": "2026-09-26",
	"assets": {
		"directory": "./dist"
	},
	// 生产路由（2026-10-05 由 publish 挂接）：星号形态同时覆盖 /starlight 与 /starlight/*；
	// 「更具体者优先」压过 cn worker 的 xianmi.co/* 与 www.xianmi.co/*，与 tw 挂 /zh-tw/* 同机制
	"routes": [
		{ "pattern": "www.xianmi.co/starlight*", "zone_name": "xianmi.co" },
		{ "pattern": "xianmi.co/starlight*", "zone_name": "xianmi.co" }
	],
	"workers_dev": true
}
