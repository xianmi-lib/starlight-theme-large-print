---
/*
 * FontSizeSelect — dropdown variant of the reader font-size switcher.
 * Same five steps as FontSizeControl (14 / 15.5 / 17 / 19 / 22px, default 17px)
 * and the SAME persistence mechanism (localStorage key `lp-font-size`,
 * `--lp-user-size` and `data-lp-step` on <html>), so preferences made with
 * either component carry over seamlessly. The theme-injected inline script
 * re-applies the saved value before first paint for both.
 *
 * Coexists with FontSizeControl on the same page: both read/write
 * `data-lp-step`, and this component syncs its display through a
 * MutationObserver on that attribute.
 *
 * No-JS: renders a native <select> (keyboard reachable, current step shown);
 * applying a step requires JS, same degradation level as Starlight's own
 * ThemeSelect/LanguageSelect.
 *
 * The trigger's "A" icon scales with the active step (14–22px, Safari-reader
 * style); JS keeps it in sync on init, step change and external writes to
 * `data-lp-step`. Without JS it stays at the 1rem fallback. The caret mirrors
 * Starlight's own Select.astro down-caret (same SVG path, 1em sizing at
 * --sl-caret-size) so all header dropdowns share one arrow.
 *
 * Usage: place inside a Header/sidebar override, e.g. next to <ThemeSelect />.
 * Pass `labels`/`ariaLabel` to localize (e.g. Traditional Chinese).
 */

interface Props {
	/** Step labels, smallest → largest (5 entries). */
	labels?: [string, string, string, string, string];
	/** Accessible name of the control. */
	ariaLabel?: string;
}

const { labels = ['小', '稍小', '标准', '大', '特大'], ariaLabel = '字号' } = Astro.props;
---

<lp-font-size-select class="lp-font-size-select">
	<label>
		<span class="sr-only">{ariaLabel}</span>
		<span class="icon label-icon" aria-hidden="true">A</span>
		<select autocomplete="off" aria-label={ariaLabel}>
			{labels.map((label, i) => <option value={i} selected={i === 2}>{label}</option>)}
		</select>
		<svg class="icon caret" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
			<path d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1.002 1.002 0 0 0 1.42 0L17 10.59a1.002 1.002 0 0 0 0-1.42Z"></path>
		</svg>
	</label>
</lp-font-size-select>

<script>
	// ⚠️ 与 FontSizeControl.astro 的同款逻辑保持同步修改（LP_KEY / LP_STEPS / apply）。
	const LP_KEY = 'lp-font-size';
	const LP_STEPS = ['14px', '15.5px', '17px', '19px', '22px'];
	const LP_DEFAULT = 2;

	function currentStep(): number {
		const attr = document.documentElement.getAttribute('data-lp-step');
		const n = attr === null ? LP_DEFAULT : Number.parseInt(attr, 10);
		return Number.isFinite(n) ? Math.max(0, Math.min(LP_STEPS.length - 1, n)) : LP_DEFAULT;
	}

	function apply(step: number) {
		const clamped = Math.max(0, Math.min(LP_STEPS.length - 1, step));
		document.documentElement.setAttribute('data-lp-step', String(clamped));
		if (clamped === LP_DEFAULT) {
			document.documentElement.style.removeProperty('--lp-user-size');
			localStorage.removeItem(LP_KEY);
		} else {
			document.documentElement.style.setProperty('--lp-user-size', LP_STEPS[clamped]!);
			localStorage.setItem(LP_KEY, LP_STEPS[clamped]!);
		}
	}

	const roots = document.querySelectorAll('lp-font-size-select');

	// 同步显示值 + 触发器 A 图标字号（图标随档位缩放，取档位 px 值本身；
	// 图标绝对定位于定高容器内，select 宽度由文本决定，触发器盒不随档变形）。
	function syncRoot(root: Element, step: number) {
		const select = root.querySelector('select')!;
		const value = String(step);
		if (select.value !== value) select.value = value;
		(root as HTMLElement).style.setProperty('--lp-icon-size', LP_STEPS[step]!);
	}

	for (const root of roots) {
		const select = root.querySelector('select')!;
		syncRoot(root, currentStep());
		select.addEventListener('change', () => apply(Number.parseInt(select.value, 10)));
	}

	// 与 FontSizeControl（或页面上其他写 data-lp-step 的控件）并存时同步显示值。
	new MutationObserver(() => {
		const step = currentStep();
		for (const root of roots) syncRoot(root, step);
	}).observe(document.documentElement, { attributes: true, attributeFilter: ['data-lp-step'] });
</script>

<style>
	@layer starlight.core {
		.lp-font-size-select label {
			--sl-label-icon-size: 1rem;
			--sl-caret-size: 1.25rem;
			--sl-inline-padding: 0.5rem;
			position: relative;
			display: flex;
			align-items: center;
			gap: 0.25rem;
			color: var(--sl-color-gray-2);
		}

		/* 与 Starlight/rapide 头部控件同族：hover/focus 变 accent 色而非纯白 */
		.lp-font-size-select label:is(:hover, :focus-within) {
			color: var(--sl-color-accent-high);
		}

		.label-icon,
		.caret {
			position: absolute;
			top: 50%;
			transform: translateY(-50%);
			pointer-events: none;
		}

		.label-icon {
			inset-inline-start: 0;
			/* 纯文字 "A" 作图标用：正常字重，对齐 rapide 头部图标视觉（600 显重）。
			   字号随档位缩放（--lp-icon-size 由组件脚本按 data-lp-step 设置，
			   取档位 px 值本身 14–22px）；无 JS/脚本未跑时回退 1rem。 */
			font-size: var(--lp-icon-size, var(--sl-label-icon-size));
			font-weight: 400;
			line-height: 1;
		}

		.caret {
			inset-inline-end: 0;
			/* 对齐 Starlight Select.astro 原生 caret：Icon.astro 按 font-size 以 1em
			   定宽高（1.25rem=20px），path 用原生 down-caret，三个下拉逐像素一致 */
			font-size: var(--sl-caret-size);
			width: 1em;
			height: 1em;
		}

		.lp-font-size-select select {
			border: 0;
			padding-block: 0.625rem;
			padding-inline: calc(var(--sl-label-icon-size) + var(--sl-inline-padding) + 0.25rem)
				calc(var(--sl-caret-size) + var(--sl-inline-padding) + 0.25rem);
			margin-inline: calc(var(--sl-inline-padding) * -1);
			background-color: transparent;
			color: inherit;
			cursor: pointer;
			appearance: none;
		}

		.lp-font-size-select option {
			background-color: var(--sl-color-bg-nav);
			color: var(--sl-color-gray-1);
		}

		@media (min-width: 50rem) {
			.lp-font-size-select select {
				font-size: var(--sl-text-sm);
			}
		}
	}
</style>
