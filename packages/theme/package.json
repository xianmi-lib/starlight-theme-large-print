{
  "name": "starlight-theme-large-print",
  "version": "0.4.2",
  "description": "Elder-friendly reading theme for Astro Starlight: larger serif body text, reader font-size control, warm dark mode, optional self-hosted CJK serif fonts.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./components/AppearanceSelect.astro": "./components/AppearanceSelect.astro",
    "./components/FontSizeControl.astro": "./components/FontSizeControl.astro",
    "./components/FontSizeSelect.astro": "./components/FontSizeSelect.astro",
    "./components/TypographyDropdown.astro": "./components/TypographyDropdown.astro",
    "./styles/paper.css": "./styles/paper.css",
    "./styles/typography.css": "./styles/typography.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.42.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "starlight",
    "starlight-plugin",
    "starlight-theme",
    "accessibility",
    "a11y",
    "large-print",
    "font-size",
    "cjk",
    "chinese"
  ]
}
